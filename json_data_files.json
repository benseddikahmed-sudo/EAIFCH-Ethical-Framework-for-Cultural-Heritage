  "unesco_categories_reference": {
    "cultural_heritage": {
      "definition": "Monuments, groups of buildings and sites with historical, aesthetic, archaeological, scientific, ethnological or anthropological value",
      "conventions": ["1972 World Heritage Convention"],
      "principles": ["authenticity", "integrity", "protection", "conservation"]
    },
    "intangible_cultural_heritage": {
      "definition": "Practices, representations, expressions, knowledge, skills transmitted from generation to generation",
      "conventions": ["2003 Convention for the Safeguarding of ICH"],
      "domains": ["oral_traditions", "performing_arts", "social_practices", "knowledge_about_nature", "traditional_craftsmanship"]
    },
    "documentary_heritage": {
      "definition": "Documents and archives of significant value to communities, cultures and individuals",
      "programs": ["Memory of the World"],
      "principles": ["accessibility", "preservation", "authenticity"]
    }
  },
  
  "care_principles_implementation": {
    "collective_benefit": {
      "description": "Data ecosystems shall be designed and function in ways that enable Indigenous Peoples to derive benefit from the data",
      "implementation_steps": [
        "identify_community_benefits",
        "negotiate_benefit_sharing",
        "ensure_community_access",
        "support_capacity_building",
        "facilitate_knowledge_return"
      ],
      "metrics": ["community_satisfaction", "capacity_built", "resources_returned"]
    },
    "authority_to_control": {
      "description": "Indigenous Peoples' rights and interests in Indigenous data must be recognised and their authority to control such data be empowered",
      "implementation_steps": [
        "recognize_data_sovereignty",
        "establish_governance_protocols",
        "respect_community_decisions",
        "support_self_determination",
        "enable_veto_power"
      ],
      "metrics": ["decision_making_power", "governance_effectiveness", "community_control"]
    },
    "responsibility": {
      "description": "Those working with Indigenous data have a responsibility to share how data are used to support Indigenous Peoples' self-determination and collective benefit",
      "implementation_steps": [
        "transparent_reporting",
        "ongoing_communication",
        "accountability_mechanisms",
        "impact_assessment",
        "responsive_adjustment"
      ],
      "metrics": ["transparency_level", "community_trust", "response_time"]
    },
    "ethics": {
      "description": "Indigenous Peoples' rights and wellbeing should be the primary concern at all stages of the data life cycle",
      "implementation_steps": [
        "ethical_review_mandatory",
        "cultural_sensitivity_training",
        "harm_prevention_protocols",
        "respectful_engagement",
        "ongoing_consent"
      ],
      "metrics": ["ethical_compliance", "harm_incidents", "community_wellbeing"]
    }
  },
  
  "consultation_protocols_detailed": {
    "free_prior_informed_consent": {
      "description": "Full community consensus required before any action",
      "steps": [
        "comprehensive_information_provision",
        "adequate_time_for_consideration",
        "community_decision_making_process",
        "documented_consent",
        "ongoing_consent_verification"
      ],
      "minimum_duration": "6 months",
      "requirements": [
        "culturally_appropriate_communication",
        "language_accessibility",
        "elder_involvement",
        "youth_inclusion",
        "written_agreement"
      ],
      "withdrawal_rights": "anytime",
      "legal_basis": ["UNDRIP", "ILO_169", "CBD"]
    },
    
    "informed_consultation": {
      "description": "Meaningful engagement with stakeholders",
      "steps": [
        "stakeholder_identification",
        "information_sharing",
        "feedback_collection",
        "consideration_of_concerns",
        "documentation"
      ],
      "minimum_duration": "3 months",
      "requirements": [
        "accessible_information",
        "multiple_consultation_rounds",
        "documented_responses",
        "good_faith_engagement"
      ],
      "withdrawal_rights": "until_final_decision"
    },
    
    "stakeholder_engagement": {
      "description": "Notification and input opportunity for interested parties",
      "steps": [
        "public_notification",
        "comment_period",
        "review_of_input",
        "decision_justification"
      ],
      "minimum_duration": "1 month",
      "requirements": [
        "public_accessibility",
        "clear_communication",
        "documented_process"
      ]
    }
  },
  
  "access_control_tiers": {
    "tier_0_public": {
      "description": "Open access with minimal restrictions",
      "permissions": ["view", "download", "cite", "educational_use"],
      "restrictions": ["attribution_required", "non_commercial_preferred"],
      "monitoring": "basic_analytics"
    },
    "tier_1_authenticated": {
      "description": "Registered users with verified identity",
      "permissions": ["view", "download_limited", "research_use"],
      "restrictions": ["attribution_mandatory", "usage_reporting", "non_commercial"],
      "monitoring": "user_tracking"
    },
    "tier_2_community": {
      "description": "Community members and approved researchers",
      "permissions": ["view", "contextual_access", "community_use"],
      "restrictions": ["community_approval", "strict_attribution", "no_reproduction"],
      "monitoring": "detailed_logging"
    },
    "tier_3_restricted": {
      "description": "Metadata only, full access requires explicit permission",
      "permissions": ["metadata_view", "request_access"],
      "restrictions": ["case_by_case_approval", "ceremonial_context_only"],
      "monitoring": "comprehensive_audit"
    }
  },
  
